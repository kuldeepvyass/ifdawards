# Server
PORT=5000
NODE_ENV=production

# MongoDB (required when you add the backend)
# MONGODB_URI=mongodb://localhost:27017/ifda
# Or use MongoDB Atlas: MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ifda

# Frontend API base URL (use when you add API calls; optional for static-only)
# VITE_API_URL=https://yourdomain.com/api

# LinkedIn auto-feed widget ID (from Elfsight)
# VITE_ELFSIGHT_LINKEDIN_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
